def agent_has_cert() -> bool:
    cp = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True)
    return cp.returncode == 0 and any(
        "-cert-" in line for line in cp.stdout.splitlines()
    )


def preflight() -> None:
    """Warn about an expiring SSH certificate before a long job, when one is
    in use. Plain-key setups have nothing to check."""
    if not agent_has_cert():
        if CFG.login_command:
            # Distinct from an expiring cert: there is nothing to expire.
            print(f"{YELLOW}▸{RESET} no SSH certificate in the agent — you may "
                  f"need to log in first: {DIM}{CFG.login_command}{RESET}")
        return
    left = cert_seconds_left()
    if left is not None and left <= 0:
        print(f"{YELLOW}▸{RESET} your SSH certificate has expired; ssh will "
              f"ask you to re-authenticate.")
    elif left is not None and left < CERT_WARN_SECONDS:
        tail = (f" — run {DIM}{CFG.login_command}{RESET} first" if CFG.login_command
                else " — renew it first")
        print(f"{YELLOW}▸{RESET} your SSH certificate expires in "
              f"{human_idle(left)}{tail} if you're starting a long job.")


def fetch() -> tuple[list[Session], list[dict]]:
    try:
        return snapshot()
    except TransportError as exc:
        if is_host_unresolvable(str(exc)):
            # The DNS record only appears once the guest has booted, so this
            # means down *or* still coming up. vm_status() disambiguates.
            print(f"{YELLOW}▸{RESET} {CFG.host} does not resolve — the host is down "
                  f"or still booting")
        else:
            print(f"{YELLOW}▸{RESET} cannot reach the host: {exc}")
        if not wait_for_host():
            sys.exit(1)
        return snapshot()


# -------------------------------------------------------------------- setup


def _ask(label: str, default: str = "", *, required: bool = False) -> str:
    """One prompt. Enter keeps the default; a lone '-' clears it."""
    while True:
        shown = f" [{default}]" if default else ""
        raw = input(f"  {label}{shown}: ").strip()  # EOFError cancels setup
        if raw == "-":
            return ""
        value = raw or default
        if value or not required:
            return value
        print(f"  {YELLOW}this one is required{RESET}")


def _ask_yes(label: str, default: bool) -> bool:
    hint = "Y/n" if default else "y/N"
    try:
        raw = input(f"  {label} [{hint}]: ").strip().lower()
    except EOFError:
        return False  # nobody there to say yes
    if not raw:
        return default
    return raw in ("y", "yes")


def _ask_pattern(label: str, default: str) -> str:
    while True:
        value = _ask(label, default)
        if not value:
            return ""
        try:
            re.compile(value)
        except re.error as exc:
            print(f"  {YELLOW}not a valid regex: {exc}{RESET}")
            continue
        return value


def run_setup(path: str) -> int:
    """Interactive config. Values from an existing file are offered as defaults."""
    cur = load_config(path) or Config()
    print(f"\n{GREEN}vmux setup{RESET}  {DIM}writes {path}{RESET}")
    print(f"{DIM}  Enter keeps the value in brackets, '-' clears it. Any value may "
          f"use {{user}} for your local username.{RESET}\n")
    try:
        cfg = Config()
        print("Where do your sessions run?")
        cfg.host = _ask("ssh host (anything `ssh` accepts, aliases included)",
                        cur.host, required=True)
        cfg.workdir = _ask("working directory for new sessions, expanded there",
                           cur.workdir or "$HOME")

        print("\nHow should Claude be started?")
        cfg.claude_model = _ask("claude --model (blank = Claude's own default)",
                                cur.claude_model)
        cfg.claude_flags = _ask("extra claude flags", cur.claude_flags)

        print("\nCan the machine be stopped and started, like a cloud VM?")
        if _ask_yes("configure VM start/stop handling", bool(cur.vm_status_command)):
            print(f"{DIM}  vmux runs the status command locally and matches its "
                  f"output against two regexes. If neither matches, it waits "
                  f"without starting anything.{RESET}")
            cfg.vm_status_command = _ask("status command (prints the VM state)",
                                         cur.vm_status_command, required=True)
            cfg.vm_running_pattern = _ask_pattern("regex meaning running",
                                                  cur.vm_running_pattern)
            cfg.vm_stopped_pattern = _ask_pattern("regex meaning stopped",
                                                  cur.vm_stopped_pattern)
            cfg.vm_start_command = _ask("start command (blank = never auto-start)",
                                        cur.vm_start_command)

        print("\nWhen ssh authentication fails:")
        cfg.login_command = _ask("command to suggest, e.g. an SSO login (blank = none)",
                                 cur.login_command)
        # Advanced keys are carried over from an existing file, not asked for.
        cfg.auth_fatal_markers = list(cur.auth_fatal_markers)
        cfg.auth_fatal_hint = cur.auth_fatal_hint
    except (KeyboardInterrupt, EOFError):
        print(f"\n{DIM}  cancelled; nothing written{RESET}")
        return 1

    save_config(path, cfg)
    print(f"\n{GREEN}✔{RESET} wrote {path}")

    if _ask_yes("test the ssh connection now", True):
        host = expand_user_placeholder(cfg.host, quoted=False)
        cp = subprocess.run(
            ["ssh", *SSH_OPTS, "-o", "BatchMode=yes", host, "tmux -V"],
            capture_output=True, text=True,
        )
        if cp.returncode == 0:
            print(f"  {GREEN}✔{RESET} {host} answers; {cp.stdout.strip() or 'tmux found'}")
        else:
            err = cp.stderr.strip()
            last = err.splitlines()[-1] if err else f"ssh exited {cp.returncode}"
            print(f"  {YELLOW}▸{RESET} {host}: {last}")
            print(f"  {DIM}fine if a login is needed first — vmux will ask for "
                  f"it when you run it{RESET}")
    return 0


def install_config(src: str, path: str) -> int:
    """Copy a shared config into place, checking that it parses first."""
    try:
        with open(src, encoding="utf-8") as fh:
            raw = json.load(fh)
    except (OSError, ValueError) as exc:
        print(f"{RED}✖{RESET} can't read {src}: {exc}")
        return 1
    if not isinstance(raw, dict):
        print(f"{RED}✖{RESET} {src} should hold a JSON object")
        return 1
    cfg = parse_config(raw, src)  # exits if bad, before anything is written
    # Store the file's own values, not the expanded ones, so {user} keeps
    # working for whoever this laptop belongs to.
    save_config(path, Config(**{k: v for k, v in raw.items() if k in CONFIG_FIELDS}))
    print(f"{GREEN}✔{RESET} installed {src} as {path}")
    print(f"  host: {cfg.host or '(none — run vmux setup)'}")
    return 0


# ---------------------------------------------------------------------- main


def main() -> int:
    global CFG
    locale.setlocale(locale.LC_ALL, "")
    parser = argparse.ArgumentParser(
        prog="vmux",
        description="A picker for Claude Code tmux sessions on a remote machine.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "commands:\n"
            "  vmux setup [--from FILE]   write the config interactively, or copy FILE in\n"
            "  vmux config                print the config path and effective values\n"
            "\n"
            f"config file: {default_config_path()}\n"
            f"             (override with --config PATH or ${CONFIG_ENV})"
        ),
    )
    parser.add_argument("command", nargs="?", choices=("setup", "config"),
                        help=argparse.SUPPRESS)
    parser.add_argument("--from", dest="from_file", metavar="FILE",
                        help="with setup: install FILE as the config instead of asking")
    parser.add_argument("--config", metavar="PATH", help="config file to use")
    parser.add_argument("-p", "--pick", action="store_true",
                        help="accepted and ignored; the picker is always shown")
    parser.add_argument("-s", "--shell", action="store_true",
                        help="with -n, make a plain shell session (no Claude)")
    parser.add_argument("-n", "--new", nargs="?", const="", metavar="NAME",
                        help="create NAME and attach; bare -n names it after Claude")
    parser.add_argument("-l", "--list", action="store_true",
                        help="print sessions and exit")
    parser.add_argument("--no-restore", action="store_true",
                        help="don't rebuild sessions lost to a VM shutdown")
    args = parser.parse_args()

    path = args.config or os.environ.get(CONFIG_ENV) or default_config_path()

    if args.command == "setup":
        if args.from_file:
            return install_config(args.from_file, path)
        return run_setup(path)

    cfg = load_config(path)
    if cfg is None:
        print(f"{DIM}  no config at {path} yet; let's write one{RESET}")
        if run_setup(path) != 0:
            return 1
        cfg = load_config(path)
        if cfg is None:
            return 1
    CFG = cfg

    if args.command == "config":
        print(f"{DIM}# {path}{RESET}")
        print(json.dumps({k: getattr(CFG, k) for k in CONFIG_FIELDS}, indent=2))
        return 0

    if not CFG.host:
        print(f"{RED}✖{RESET} no host configured; run {DIM}vmux setup{RESET}")
        return 2

    preflight()

    if args.list:
        for s in fetch()[0]:
            state = "attached" if s.attached else f"idle {human_idle(s.idle)}"
            print(f"{s.name:<24} {s.windows:>2} win  {state}")
        return 0

    if args.new is not None:
        auto = args.new == ""
        name = auto_name() if auto else normalize_name(args.new)
        if not valid_name(name):
            print(f"{RED}✖{RESET} names may use letters, digits, - and _ only")
            return 2
        try:
            if args.shell:
                create_plain_session(name)
                claude_id = None
            else:
                _, records = fetch()
                _, rec = create_session(name, auto_rename=auto)
                save_records(records + [rec])
                claude_id = rec["claude_id"]
        except RuntimeError as exc:
            print(f"{RED}✖{RESET} {exc}")
            return 1
        # Detaching falls through to the picker rather than exiting, so where
        # you land after C-b d doesn't depend on how the tab was launched.
        attach_with_reconnect(name, claude_id)

    sessions, records = fetch()

    # Anything vmux made that the VM shutdown took gets rebuilt, with its Claude
    # conversation resumed rather than started over.
    alive, missing = reconcile(sessions, records)
    if missing and not args.no_restore:
        restored = restore_missing(missing, sessions)
        save_records(alive + restored)
        if restored:
            sessions, records = fetch()
    elif len(alive) != len(records):
        save_records(alive)  # prune records for sessions killed elsewhere

    note = ""

    # Nothing running: an empty picker is a dead end, so just make the session.
    # Startup only — doing this inside the loop would mean killing your last
    # session from the picker instantly conjures another one you can't escape.
    if not sessions:
        name = auto_name()
        print(f"{DIM}  no sessions on the host; creating {name}{RESET}")
        try:
            _, rec = create_session(name, auto_rename=True)
            save_records(records + [rec])
        except RuntimeError as exc:
            print(f"{RED}✖{RESET} {exc}")
            return 1
        attach_with_reconnect(name, rec["claude_id"])
        # Re-read before the picker: `sessions` is still the empty list that
        # sent us down this branch, so the loop would render nothing.
        sessions, records = fetch()

    while True:
        action, payload = curses.wrapper(picker, sessions, note)
        note = ""

        if action == "quit":
            return 0
        if action == "attach":
            # Outside curses, so the terminal is fully restored before ssh -t.
            picked = next((s for s in sessions if s.name == payload), None)
            attach_with_reconnect(payload, picked.claude_id if picked else None)
        elif action in ("new", "new-auto"):
            auto = action == "new-auto"
            name = auto_name() if auto else payload
            try:
                _, rec = create_session(name, auto_rename=auto)
                save_records(records + [rec])
                attach_with_reconnect(name, rec["claude_id"])
            except RuntimeError as exc:
                note = str(exc)
        elif action == "kill":
            try:
                kill_session(payload)
                # Drop the record too, or the next run would resurrect it.
                gone = {s.claude_id for s in sessions if s.name == payload}
                save_records([r for r in records
                              if r.get("claude_id") not in gone])
                note = f"killed {payload}"
            except RuntimeError as exc:
                note = str(exc)
        elif action == "rename":
            old, new = payload
            try:
                rename_session(old, new)
                note = f"renamed {old} → {new}"
            except RuntimeError as exc:
                note = str(exc)

        sessions, records = fetch()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
